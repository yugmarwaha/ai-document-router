{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn compile)",
      "Bash(mvn spring-boot:run)",
      "Bash(mvn clean package)",
      "Bash(mvn test)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl *)"
    ],
    "deny": [
      "Read(./**/application-local.properties)",
      "Bash(git push --force *)"
    ]
  },
  "env": {
    "SPRING_PROFILES_ACTIVE": "local"
  }
}
